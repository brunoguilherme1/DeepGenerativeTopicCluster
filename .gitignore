__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/

# Immutable-once-downloaded raw data and its cache - regenerated by the
# dataset fetchers (checksums recorded in each raw_dir's MANIFEST.yaml,
# not lost by gitignoring the data itself).
data/raw/
data/processed/

# Model checkpoints written during training - not reproducibility
# artifacts themselves (the config/seed that produced them is what's
# committed, in results/<protocol>/protocol.json).
*.weights.h5
vaebm_training.csv

# Real Palmetto + the Wikipedia_bd coherence index (scripts/
# setup_palmetto.py) - a ~5.9MB jar plus a ~5.1GB-compressed external
# download, never meant to be committed. metrics/palmetto.py's own
# DEFAULT_JAR/DEFAULT_WIKI_INDEX point here.
tools/palmetto/

# Ad-hoc SLURM job scripts/stdout generated directly on the cluster while
# driving a sweep (scripts/run_sbert11_sweep.py / run_cluster7_sweep.py
# are the real, committed drivers - these are just their SLURM wrapper
# scripts + stdout captures, regenerated per-run, never meant to be
# committed).
run_sweep.sbatch
resume_sweep.sbatch
sweep_slurm_*.out
resume_slurm_*.out

# Sweep run outputs/checkpoints/logs (regenerated per-run, never
# meant to be committed) and their SLURM wrapper stdout captures.
results/
cluster7_slurm_*.out
cluster7_resume_slurm_*.out
run_cluster7_sweep.sbatch
resume_cluster7_sweep.sbatch
NAACL_HLT_2021_Latex_Template__1_/main.pdf
NAACL_HLT_2021_Latex_Template__1_/main.log
NAACL_HLT_2021_Latex_Template__1_/main.blg
.DS_Store
