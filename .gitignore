__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/

# Immutable-once-downloaded raw data and its cache - regenerated by the
# dataset fetchers (checksums recorded in each raw_dir's MANIFEST.yaml,
# not lost by gitignoring the data itself).
data/raw/
data/processed/

# Model checkpoints written during training - not reproducibility
# artifacts themselves (the config/seed that produced them is what's
# committed, in results/<protocol>/protocol.json).
*.weights.h5
vaebm_training.csv
